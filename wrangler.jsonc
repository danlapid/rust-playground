{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rust-playground",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Runs each compiled program in its own sandboxed isolate.
  "worker_loaders": [{ "binding": "LOADER" }],
  // Pipeline steps, each its own Worker so each gets its own isolate and memory budget.
  "services": [
    { "binding": "COMPILER", "service": "rust-playground-compiler", "entrypoint": "Compiler" },
    { "binding": "LINKER", "service": "rust-playground-linker", "entrypoint": "Linker" }
  ],
  // crates.io index files, .crate files, and compiled dependencies, by content hash.
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "rust-playground-artifacts" }],
  "assets": { "directory": "public" },
  // Workers Cache, for the Cached entrypoint only (src/cache.ts): what it caches is keyed by
  // its inputs, rustc included, so it stays good across deploys.
  "cache": { "enabled": true, "cross_version_cache": true },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "Cached": { "type": "worker", "cache": { "enabled": true } }
  },
  "rules": [
    // Sources handed to Dynamic Workers as strings, not modules of this Worker.
    { "type": "Text", "globs": ["**/runtime.mjs", "**/runner/entry.js", "**/*.rs"], "fallthrough": false }
  ]
}
