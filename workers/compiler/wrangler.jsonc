{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rust-playground-compiler",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // std's object code and emscripten's libraries are read through node:fs from /bundle,
  // so they ship as additional modules rather than imports. `pnpm toolchain:stage` copies
  // them into src/generated/.
  "find_additional_modules": true,
  // std's crate metadata, which doesn't fit in the bundle beside rustc: compressed pages
  // that `pnpm toolchain:stage` writes into assets/. Only this Worker reads them, through
  // the binding; requests from outside reach the Worker, which turns them away.
  "assets": { "directory": "assets", "binding": "ASSETS", "run_worker_first": true },
  // Runs proc macros, each in its own sandboxed isolate.
  "worker_loaders": [{ "binding": "LOADER" }],
  "rules": [
    // Sources handed to Dynamic Workers as strings.
    { "type": "Text", "globs": ["**/runtime.mjs", "**/proc-macro/entry.js"], "fallthrough": false },
    { "type": "Data", "globs": ["generated/**/*.a", "generated/**/*.o", "generated/**/*.rlib", "generated/**/*.stub"], "fallthrough": false }
  ],
  // rustc's memory, in MiB, at most: past the isolate's 128 MB limit, which holds only
  // until the request is done, but short of where it's killed outright (about 230 MB),
  // beside std's metadata (27 MiB, see src/sysroot.ts) and the run's files (see
  // src/index.ts). Some crates take more to compile, so building them is up to a host
  // without the limit (scripts/warm-cache.mjs); tests lift it too.
  "vars": { "RUSTC_MEMORY_MIB": "150" },
  "limits": { "cpu_ms": 300000 }
}
