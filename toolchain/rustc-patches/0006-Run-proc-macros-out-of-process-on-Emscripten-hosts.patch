+/// On Emscripten hosts, proc macros are WebAssembly modules that the host runs
+/// elsewhere (see `rustc_proc_macro::bridge::remote`).
+#[cfg(target_os = "emscripten")]
+pub(crate) fn dlsym_proc_macros(
+    path: &Path,
+    _stable_crate_id: StableCrateId,
+) -> Result<&'static [ProcMacroClient], DylibError> {
+    let display = path.display().to_string();
+    rustc_proc_macro::bridge::remote::clients(&display).map_err(|e| DylibError::DlOpen(display, e))
+}
