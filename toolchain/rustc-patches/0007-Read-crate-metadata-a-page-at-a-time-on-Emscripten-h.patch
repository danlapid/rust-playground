+/// Crate metadata in a file, read a page at a time as decoding reaches it. On hosts where
+/// mapping a file reads all of it (Emscripten), this keeps a compilation from holding all
+/// of every dependency's metadata in memory, when it only decodes a fraction of it.
+struct PagedFile {
+    file: Mutex<File>,
+    /// Where the metadata starts in the file.
+    offset: u64,
+    /// Its length, not counting [`MAGIC_END_BYTES`].
+    len: usize,
+    pages: Box<[OnceLock<Box<[u8]>>]>,
+    /// Ranges that span pages, by position, which live as long as the pages do.
+    spans: Mutex<FxHashMap<usize, Box<[u8]>>>,
+}
+
+impl PagedFile {
+    const PAGE: usize = 16 * 1024;
+
+    fn new(file: File, offset: u64, len: usize) -> Result<Self, ()> {
+        let len = len.checked_sub(MAGIC_END_BYTES.len()).ok_or(())?;
+        let pages = (0..len.div_ceil(Self::PAGE)).map(|_| OnceLock::new()).collect();
+        let paged = PagedFile { file: Mutex::new(file), offset, len, pages, spans: Default::default() };
+        let mut magic = [0; MAGIC_END_BYTES.len()];
+        paged.read_file(len, &mut magic);
+        if magic == MAGIC_END_BYTES { Ok(paged) } else { Err(()) }
+    }
+
+    fn read_file(&self, pos: usize, buf: &mut [u8]) {
+        let mut file = self.file.lock().unwrap();
+        file.seek(SeekFrom::Start(self.offset + pos as u64))
+            .and_then(|_| file.read_exact(buf))
+            .unwrap_or_else(|e| panic!("failed to read crate metadata: {e}"));
+    }
+
+    /// Copies the bytes at `pos` into `buf`, through the pages they are on.
+    fn read(&self, mut pos: usize, mut buf: &mut [u8]) {
+        while !buf.is_empty() {
+            let (start, page) = self.page(pos);
+            let n = buf.len().min(start + page.len() - pos);
+            buf[..n].copy_from_slice(&page[pos - start..][..n]);
+            (pos, buf) = (pos + n, &mut buf[n..]);
+        }
+    }
+}
+
+impl PagedBytes for PagedFile {
+    fn len(&self) -> usize {
+        self.len
+    }
+
+    fn page(&self, pos: usize) -> (usize, &[u8]) {
+        let start = pos / Self::PAGE * Self::PAGE;
+        let page = self.pages[pos / Self::PAGE].get_or_init(|| {
+            let mut page = vec![0; Self::PAGE.min(self.len - start)];
+            self.read_file(start, &mut page);
+            page.into_boxed_slice()
+        });
+        (start, page)
+    }
+
+    fn bytes(&self, pos: usize, len: usize) -> &[u8] {
+        if len == 0 {
+            return &[];
+        }
+        let (start, page) = self.page(pos);
+        if pos - start + len <= page.len() {
+            return &page[pos - start..][..len];
+        }
+        let mut spans = self.spans.lock().unwrap();
+        let span = spans.entry(pos).or_default();
+        if span.len() < len {
+            let mut bytes = vec![0; len];
+            self.read(pos, &mut bytes);
+            *span = bytes.into_boxed_slice();
+        }
+        let span: *const [u8] = &span[..len];
+        // SAFETY: A boxed slice's bytes don't move when the box does, and they are only
+        // dropped with `self`: a span is replaced only by a longer one, which it is not.
+        unsafe { &*span }
     }
 }
 
