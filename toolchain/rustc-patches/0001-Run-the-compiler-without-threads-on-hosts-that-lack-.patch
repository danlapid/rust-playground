+// Without threads (see `no_threads`), the coordinator runs when it is joined and work
+// items run inline. By then the main thread has queued all of its codegen messages, so
+// the coordinator first takes in every codegen unit, then lends the main thread's
+// implicit token to each work item in turn.
+
+/// A thread, or on hosts without threads, a closure run when joined.
+enum MaybeThread<T> {
+    Thread(thread::JoinHandle<T>),
+    Deferred(Box<dyn FnOnce() -> T + Send>),
+}
+
+impl<T: Send + 'static> MaybeThread<T> {
+    fn spawn(name: &str, f: impl FnOnce() -> T + Send + 'static) -> Self {
+        if no_threads() {
+            MaybeThread::Deferred(Box::new(f))
+        } else {
+            MaybeThread::Thread(
+                thread::Builder::new()
+                    .name(name.to_owned())
+                    .spawn(f)
+                    .unwrap_or_else(|e| panic!("failed to spawn {name} thread: {e}")),
+            )
+        }
+    }
+
+    fn join(self) -> thread::Result<T> {
+        match self {
+            MaybeThread::Thread(handle) => handle.join(),
+            MaybeThread::Deferred(f) => std::panic::catch_unwind(AssertUnwindSafe(f)),
+        }
+    }
+}
+
+/// Runs a work item's closure on its own thread, or inline on hosts without threads.
+fn spawn_work_thread(name: String, f: impl FnOnce() + Send + 'static) {
+    if no_threads() {
+        f()
+    } else {
+        thread::Builder::new().name(name).spawn(f).expect("failed to spawn work thread");
+    }
+}
