+/// Whether the host cannot spawn threads (Emscripten without pthreads, e.g. rustc
+/// running in a Cloudflare Worker). The compiler then runs entirely on the main thread.
+///
+/// `RUSTC_NO_THREADS` forces this on other hosts, to test it natively.
+pub fn no_threads() -> bool {
+    static NO_THREADS: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| {
+        cfg!(all(target_family = "wasm", not(target_feature = "atomics")))
+            || std::env::var_os("RUSTC_NO_THREADS").is_some()
+    });
+    *NO_THREADS
+}
